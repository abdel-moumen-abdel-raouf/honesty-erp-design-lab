{
  "name": "honesty-erp-design-lab",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "cross-env ng serve --port=3000 --host=0.0.0.0 --allowed-hosts=true ${DISABLE_HMR:+--live-reload=false}",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "component-tokens:check": "node tools/foundation/check-component-token-framework.mjs",
    "component-tokens:check:self-test": "node tools/foundation/check-component-token-framework.mjs --self-test",
    "system-colors:generate": "node tools/foundation/generate-system-color-registry.mjs",
    "system-colors:check": "node tools/foundation/generate-system-color-registry.mjs --check",
    "system-colors:check:self-test": "node tools/foundation/generate-system-color-registry.mjs --self-test",
    "erp-text:check": "node tools/typography/check-erp-text-coverage.mjs",
    "erp-text:check:self-test": "node tools/typography/check-erp-text-coverage.mjs --self-test",
    "erp-icon:registry:generate": "node tools/icons/generate-erp-icon-registry.mjs",
    "erp-icon:registry:check": "node tools/icons/generate-erp-icon-registry.mjs --check",
    "erp-icon:check": "npm run erp-icon:registry:check && node tools/icons/check-erp-icon-governance.mjs",
    "erp-icon:check:self-test": "node tools/icons/check-erp-icon-governance.mjs --self-test",
    "erp-button:check": "node tools/controls/check-erp-button-governance.mjs",
    "erp-button:check:self-test": "node tools/controls/check-erp-button-governance.mjs --self-test",
    "erp-tooltip:check": "node tools/controls/check-erp-tooltip-governance.mjs",
    "erp-tooltip:check:self-test": "node tools/controls/check-erp-tooltip-governance.mjs --self-test",
    "erp-field:check": "node tools/controls/check-erp-field-governance.mjs",
    "erp-field:check:self-test": "node tools/controls/check-erp-field-governance.mjs --self-test",
    "erp-overlay:check": "node tools/controls/check-erp-overlay-governance.mjs",
    "erp-overlay:check:self-test": "node tools/controls/check-erp-overlay-governance.mjs --self-test",
    "lint": "npm run theme-authority:check && npm run route-pages:check && npm run component-tokens:check && npm run system-colors:check && npm run erp-text:check && npm run erp-icon:check && npm run erp-button:check && npm run erp-tooltip:check && npm run erp-field:check && npm run erp-empty-state:check && npm run erp-overlay:check && npm run erp-confirm:check && npm run erp-data-table:check && npm run erp-forms:check && npm run erp-entity-form:check && npm run erp-shell-navigation:check && ng lint",
    "route-pages:check": "node tools/foundation/check-route-page-erp-authoring.mjs",
    "route-pages:check:self-test": "node tools/foundation/check-route-page-erp-authoring.mjs --self-test",
    "verify:clean": "npm run lint && npm run test -- --watch=false && npm run typecheck:app && npm run typecheck:spec && npm run build:clean",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "build:clean": "node tools/verification/check-zero-warning-build.mjs",
    "theme-authority:check": "node tools/foundation/check-single-theme-authority.mjs",
    "theme-authority:check:self-test": "node tools/foundation/check-single-theme-authority.mjs --self-test",
    "build:clean:self-test": "node tools/verification/check-zero-warning-build.mjs --self-test",
    "erp-confirm:check": "node tools/controls/check-erp-confirm-dialog-governance.mjs",
    "erp-confirm:check:self-test": "node tools/controls/check-erp-confirm-dialog-governance.mjs --self-test",
    "erp-empty-state:check": "node tools/controls/check-erp-empty-state-governance.mjs",
    "erp-empty-state:check:self-test": "node tools/controls/check-erp-empty-state-governance.mjs --self-test",
    "erp-data-table:check": "node tools/controls/check-erp-data-table-governance.mjs",
    "erp-data-table:check:self-test": "node tools/controls/check-erp-data-table-governance.mjs --self-test",
    "erp-forms:check": "node tools/controls/check-erp-forms-governance.mjs",
    "erp-forms:check:self-test": "node tools/controls/check-erp-forms-governance.mjs --self-test",
    "erp-entity-form:check": "node tools/controls/check-erp-entity-form-governance.mjs",
    "erp-entity-form:check:self-test": "node tools/controls/check-erp-entity-form-governance.mjs --self-test",
    "erp-shell-navigation:check": "node tools/controls/check-erp-shell-navigation-governance.mjs",
    "erp-shell-navigation:check:self-test": "node tools/controls/check-erp-shell-navigation-governance.mjs --self-test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/platform-browser": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@ng-icons/core": "33.4.0",
    "@ng-icons/fluent-ui": "33.4.0",
    "@ng-icons/heroicons": "33.4.0",
    "@ng-icons/lucide": "33.4.0",
    "@ng-icons/phosphor-icons": "33.4.0",
    "@ng-icons/tabler-icons": "33.4.0",
    "animate.css": "4.1.1",
    "html2canvas": "^1.4.1",
    "lottie-web": "5.13.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.4",
    "@types/node": "^25.5.0",
    "angular-eslint": "^21.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8"
  }
}
